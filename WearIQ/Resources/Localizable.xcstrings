{
  "sourceLanguage": "en",
  "strings": {
    "Home": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana Sayfa"
          }
        }
      }
    },
    "Scan": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kıyafet Tara"
          }
        }
      }
    },
    "Wardrobe": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardırop"
          }
        }
      }
    },
    "Style": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stil Asistanı"
          }
        }
      }
    },
    "Profile": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil"
          }
        }
      }
    },
    "Scan a garment": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kıyafet tara"
          }
        }
      }
    },
    "Premium: unlimited scans": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium: sınırsız tarama"
          }
        }
      }
    },
    "Scans left today": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün kalan tarama"
          }
        }
      }
    },
    "%lld / %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld"
          }
        }
      }
    },
    "Free scans renew every day.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz taramalar her gün yenilenir."
          }
        }
      }
    },
    "Body profile": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut profili"
          }
        }
      }
    },
    "%lld measurements saved": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ölçü kayıtlı"
          }
        }
      }
    },
    "Coming in phase %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld. aşamada geliyor"
          }
        }
      }
    },
    "Not available yet, planned for phase %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kullanılamıyor, %lld. aşamada planlandı"
          }
        }
      }
    },
    "Paste a product link": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ürün bağlantısı yapıştır"
          }
        }
      }
    },
    "Reads the product name, sizes and size chart where the store publishes them.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mağaza yayımlıyorsa ürün adını, bedenleri ve beden tablosunu okur."
          }
        }
      }
    },
    "Scan a barcode": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barkod tara"
          }
        }
      }
    },
    "Identifies the product from its EAN/UPC code. A barcode alone has no measurements.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ürünü EAN/UPC kodundan tanır. Barkod tek başına ölçü içermez."
          }
        }
      }
    },
    "Read a size chart photo": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beden tablosu fotoğrafı oku"
          }
        }
      }
    },
    "Extracts measurements from a size chart screenshot or garment label on your device.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beden tablosu ekran görüntüsünden veya etiketten ölçüleri cihazında çıkarır."
          }
        }
      }
    },
    "Digital wardrobe": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijital gardırop"
          }
        }
      }
    },
    "Keep your clothes with category, colour, size, fit, season and photo, and filter them anytime.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kıyafetlerini kategori, renk, beden, kalıp, mevsim ve fotoğrafla sakla, istediğin zaman filtrele."
          }
        }
      }
    },
    "Style assistant": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stil asistanı"
          }
        }
      }
    },
    "Outfit suggestions from your own wardrobe for daily, work, formal, sport and evening occasions.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi gardırobundan günlük, iş, resmî, spor ve akşam için kombin önerileri."
          }
        }
      }
    },
    "Premium": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium"
          }
        }
      }
    },
    "Privacy": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik"
          }
        }
      }
    },
    "Photos are processed on this device and are not uploaded.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar bu cihazda işlenir ve yüklenmez."
          }
        }
      }
    },
    "Your measurements are never shared with advertisers.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçülerin hiçbir zaman reklamverenlerle paylaşılmaz."
          }
        }
      }
    },
    "Delete all my data": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm verilerimi sil"
          }
        }
      }
    },
    "Removes your body profile, saved analyses and wardrobe from this device.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut profilini, kayıtlı analizleri ve gardırobu bu cihazdan siler."
          }
        }
      }
    },
    "Delete all your data?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm verilerin silinsin mi?"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sil"
          }
        }
      }
    },
    "This can't be undone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem geri alınamaz."
          }
        }
      }
    },
    "Couldn't delete data": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veriler silinemedi"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamam"
          }
        }
      }
    },
    "Scan once": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez tara"
          }
        }
      }
    },
    "Create your body profile one time. Every garment is checked against it afterwards.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut profilini bir kez oluştur. Sonrasında her kıyafet bu profile göre değerlendirilir."
          }
        }
      }
    },
    "Know how it fits": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasıl oturacağını bil"
          }
        }
      }
    },
    "See how shoulders, chest, waist, sleeves and length will sit, size by size.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omuz, göğüs, bel, kol ve boyun her bedende nasıl duracağını gör."
          }
        }
      }
    },
    "Pick the right size": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğru bedeni seç"
          }
        }
      }
    },
    "Get a size recommendation with an honest confidence level, not a guess.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahmin değil, dürüst bir güven seviyesiyle beden önerisi al."
          }
        }
      }
    },
    "Private by design": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik odaklı"
          }
        }
      }
    },
    "Your photos are analysed on this device and deleted after measuring. No account required.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafların bu cihazda analiz edilir ve ölçümden sonra silinir. Hesap gerekmez."
          }
        }
      }
    },
    "Get started": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başla"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam"
          }
        }
      }
    },
    "WearIQ": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "WearIQ"
          }
        }
      }
    },
    "No camera is available on this device.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda kullanılabilir kamera yok."
          }
        }
      }
    },
    "The camera could not be started.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera başlatılamadı."
          }
        }
      }
    },
    "No person was found in the photo.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafta kişi bulunamadı."
          }
        }
      }
    },
    "The body outline could not be detected.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut hatları algılanamadı."
          }
        }
      }
    },
    "Stand facing the phone, arms slightly away from your body.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefona dönük dur, kollarını vücudundan biraz uzak tut."
          }
        }
      }
    },
    "Turn to your side.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yan dön."
          }
        }
      }
    },
    "Great. Now turn to your side and keep your arms relaxed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harika. Şimdi yan dön ve kollarını serbest bırak."
          }
        }
      }
    },
    "We couldn't find you in the photo. Make sure your whole body is visible and the room is well lit.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seni fotoğrafta bulamadık. Tüm vücudunun göründüğünden ve ortamın aydınlık olduğundan emin ol."
          }
        }
      }
    },
    "Some body points weren't visible. Wear fitted clothes and keep your whole body in frame.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı vücut noktaları görünmedi. Dar kıyafet giy ve tüm vücudunu kadrajda tut."
          }
        }
      }
    },
    "Step into the frame.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadraja gir."
          }
        }
      }
    },
    "Your head is cut off. Step back or tilt the phone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başın kadrajın dışında. Geri çekil veya telefonu eğ."
          }
        }
      }
    },
    "Your feet aren't visible. Step back.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayakların görünmüyor. Geri çekil."
          }
        }
      }
    },
    "Step back a little.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biraz geri çekil."
          }
        }
      }
    },
    "Come a little closer.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biraz yaklaş."
          }
        }
      }
    },
    "Move to the centre of the frame.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadrajın ortasına geç."
          }
        }
      }
    },
    "Face the phone directly.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefona tam karşıdan bak."
          }
        }
      }
    },
    "Hold your arms slightly away from your body.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kollarını vücudundan biraz uzak tut."
          }
        }
      }
    },
    "Turn fully to your side.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamen yan dön."
          }
        }
      }
    },
    "Height": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boy"
          }
        }
      }
    },
    "Shoulder width": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omuz genişliği"
          }
        }
      }
    },
    "Arm length": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kol uzunluğu"
          }
        }
      }
    },
    "Chest": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göğüs"
          }
        }
      }
    },
    "Waist": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bel"
          }
        }
      }
    },
    "Hip": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalça"
          }
        }
      }
    },
    "Thigh": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyluk"
          }
        }
      }
    },
    "Torso length": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gövde uzunluğu"
          }
        }
      }
    },
    "Inseam": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İç bacak"
          }
        }
      }
    },
    "Outseam": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dış bacak"
          }
        }
      }
    },
    "Barefoot, back against a wall, from floor to the top of your head.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalın ayak, sırtın duvara dönük, yerden başının tepesine kadar."
          }
        }
      }
    },
    "Across your back, from the outer edge of one shoulder bone to the other.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sırtından, bir omuz kemiğinin dış ucundan diğerine."
          }
        }
      }
    },
    "From the shoulder bone, over a slightly bent elbow, to the wrist bone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omuz kemiğinden, hafif bükülü dirsek üzerinden bilek kemiğine."
          }
        }
      }
    },
    "Around the fullest part of your chest, under the armpits, tape level.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göğsün en geniş yerinden, koltuk altlarının altından, mezura yere paralel."
          }
        }
      }
    },
    "Around your natural waist, the narrowest part, without pulling in.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğal bel hizandan, en ince yerinden, karnını içine çekmeden."
          }
        }
      }
    },
    "Around the fullest part of your hips and seat, feet together.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalçanın en geniş yerinden, ayaklar bitişik."
          }
        }
      }
    },
    "Around the fullest part of one thigh, just below the crotch.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir uyluğun en geniş yerinden, kasığın hemen altından."
          }
        }
      }
    },
    "From the bone at the base of your neck down your back to your waist.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensenin altındaki kemikten sırt boyunca bele kadar."
          }
        }
      }
    },
    "From the crotch down the inside of the leg to the floor, barefoot.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalın ayak, kasıktan bacağın iç tarafı boyunca yere kadar."
          }
        }
      }
    },
    "From your waist down the outside of the leg to the floor, barefoot.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalın ayak, belden bacağın dış tarafı boyunca yere kadar."
          }
        }
      }
    },
    "High confidence": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek güven"
          }
        }
      }
    },
    "Medium confidence": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orta güven"
          }
        }
      }
    },
    "Low confidence": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük güven"
          }
        }
      }
    },
    "Scanned": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarandı"
          }
        }
      }
    },
    "Measured": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçüldü"
          }
        }
      }
    },
    "Entered": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girildi"
          }
        }
      }
    },
    "Values marked low confidence are rough estimates from photos. For better size advice, measure them with a tape and tap to correct.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük güvenli değerler fotoğraftan yapılmış kaba tahminlerdir. Daha iyi beden önerisi için mezurayla ölç ve dokunarak düzelt."
          }
        }
      }
    },
    "Photo-based values are estimates. Tap any value to replace it with your own measurement.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraftan çıkarılan değerler tahminidir. Kendi ölçünle değiştirmek için herhangi bir değere dokun."
          }
        }
      }
    },
    "Your measurements": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçülerin"
          }
        }
      }
    },
    "Without chest and waist we can't recommend sizes yet.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göğüs ve bel ölçüsü olmadan henüz beden önerisi yapamayız."
          }
        }
      }
    },
    "Save measurements": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçüleri kaydet"
          }
        }
      }
    },
    "Couldn't save": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilemedi"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekle"
          }
        }
      }
    },
    "Value": {
      "localizations": {
        "tr": {
          "stringUnit": {
