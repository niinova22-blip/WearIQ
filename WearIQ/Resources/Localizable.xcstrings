    "(estimated)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "(tahmini)"
          }
        }
      }
    },
    "Great. Now I'll take a photo from eight directions. Hold your arms straight out at shoulder height. After each photo, turn 45 degrees to your right and stop.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harika. Şimdi sekiz yönden fotoğraf çekeceğim. Kollarını omuz hizasında yana aç. Her fotoğraftan sonra sağına doğru 45 derece dön ve dur."
          }
        }
      }
    },
    "Turn 45 degrees to your right and stop.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağına doğru 45 derece dön ve dur."
          }
        }
      }
    },
    "Another 45 degrees to your right. Your left side faces the phone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağına doğru 45 derece daha dön. Sol yanın telefona baksın."
          }
        }
      }
    },
    "Another 45 degrees to your right. Your back faces the phone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağına doğru 45 derece daha dön. Sırtın telefona baksın."
          }
        }
      }
    },
    "Another 45 degrees to your right. Your right side faces the phone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağına doğru 45 derece daha dön. Sağ yanın telefona baksın."
          }
        }
      }
    },
    "Last photo: another 45 degrees to your right, and stop.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son fotoğraf: sağına doğru 45 derece daha dön ve dur."
          }
        }
      }
    },
    "Another 45 degrees to your right, and stop.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağına doğru 45 derece daha dön ve dur."
          }
        }
      }
    },
    "Photo taken.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf alındı."
          }
        }
      }
    },
    "You haven't turned yet. Turn 45 degrees to your right.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz dönmedin. Sağına doğru 45 derece dön."
          }
        }
      }
    },
    "Photos are processed on this phone and deleted right away. Nothing is sent anywhere.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar yalnızca bu telefonda işlenir ve hemen silinir. Hiçbir yere gönderilmez."
          }
        }
      }
    },
    "Photo %lld of %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf %1$lld/%2$lld"
          }
        }
      }
    },
    "Choose what you're wearing": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne giydiğini seç"
          }
        }
      }
    },
    "About a minute": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşık bir dakika"
          }
        }
      }
    },
    "Voice guidance leads you; photos are taken automatically.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli yönlendirme eşlik eder; fotoğraflar kendiliğinden çekilir."
          }
        }
      }
    },
    "A front photo": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önden bir fotoğraf"
          }
        }
      }
    },
    "Face the phone, arms slightly away from your body.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefona dön, kolların gövdenden biraz açık."
          }
        }
      }
    },
    "Eight directions": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekiz yönden"
          }
        }
      }
    },
    "Arms out at shoulder height; after each photo turn 45° to your right.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kollar omuz hizasında yana açık; her fotoğraftan sonra sağına 45° dön."
          }
        }
      }
    },
    "Bright room, plain background": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aydınlık oda, sade arka plan"
          }
        }
      }
    },
    "Barefoot, long hair tied up": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıplak ayak, uzun saç toplu"
          }
        }
      }
    },
    "Sound on: you'll be facing away": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi aç: arkan dönük olacak"
          }
        }
      }
    },
    "Fitted or underwear": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar kıyafet ya da iç çamaşırı"
          }
        }
      }
    },
    "Most accurate": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En doğru sonuç"
          }
        }
      }
    },
    "Shown with a range": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aralıkla gösterilir"
          }
        }
      }
    },
    "Photos are processed only on this phone and deleted right away. Nothing is sent anywhere.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar yalnızca bu telefonda işlenir ve hemen silinir. Hiçbir yere gönderilmez."
          }
        }
      }
    },
    "One minute, once. Every garment is checked against your body.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez, bir dakikada. Her giysi senin vücuduna göre kontrol edilir."
          }
        }
      }
    },
    "See it on your 3D avatar: shoulders, waist, sleeves and where the hem ends.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3B avatarında gör: omuz, bel, kollar ve eteğin nerede bittiği."
          }
        }
      }
    },
    "A size recommendation with an honest confidence, not a guess.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahmin değil; dürüst bir güvenle beden önerisi."
          }
        }
      }
    },
    "Keep turning slowly to your right.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağına doğru yavaşça dönmeye devam et."
          }
        }
      }
    },
    "Keep your arms out at shoulder height.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kollarını omuz hizasında açık tut."
          }
        }
      }
    },
    "That was a little fast. Once more, more slowly.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biraz hızlı oldu. Bir kez daha, daha yavaş."
          }
        }
      }
    },
    "Turning: %lld%%": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dönüş: %%%lld"
          }
        }
      }
    },
    "Sweater / sweatshirt": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kazak / sweatshirt"
          }
        }
      }
    },
    "Shorts": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şort"
          }
        }
      }
    },
    "Hide %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gizle"
          }
        }
      }
    },
    "Show %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ göster"
          }
        }
      }
    },
    "One slow turn": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek yavaş tur"
          }
        }
      }
    },
    "After 3, 2, 1: arms out at shoulder height, turn slowly once round to your right. About 15 seconds.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3, 2, 1'den sonra: kollar omuz hizasında açık, sağına doğru yavaşça bir tur dön. Yaklaşık 15 saniye."
          }
        }
      }
    },
    "A quick skin tone scan and three questions. With your measurements, WearIQ suggests the style, colours, fabrics and cuts that suit you.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa bir cilt tonu taraması ve üç soru. Ölçülerinle birlikte WearIQ sana uyan tarzı, renkleri, kumaşları ve kesimleri önerir."
          }
        }
      }
    },
    "%@ suits your build.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vücut yapına uyuyor."
          }
        }
      }
    },
    "%@ works with care; %@ may suit you better.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dikkatle uygulanırsa olur; %2$@ sana daha iyi uyabilir."
          }
        }
      }
    },
    "Cuts": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesimler"
          }
        }
      }
    },
    "Fabrics": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumaşlar"
          }
        }
      }
    },
    "Use sparingly": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Az kullan"
          }
        }
      }
    },
    "Colour proportions": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renk oranları"
          }
        }
      }
    },
    "Washing and care": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıkama ve bakım"
          }
        }
      }
    },
    "Cotton and denim: 30–40 °C, inside out; wash jeans rarely and dry them on a line to keep the colour.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamuk ve denim: 30–40 °C, ters çevirerek; kotu seyrek yıka, rengi korunsun diye askıda kurut."
          }
        }
      }
    },
    "Wool and knitwear: cold hand wash or the wool programme, dry flat; never wring or tumble-dry.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yün ve triko: soğuk elde ya da yünlü programında yıka, yatay kurut; asla sıkma, kurutmaya atma."
          }
        }
      }
    },
    "Viscose and modal: 30 °C gentle cycle, low spin; they shrink in heat.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Viskon ve modal: 30 °C hassas program, düşük sıkma; sıcakta çeker."
          }
        }
      }
    },
    "Linen: 30–40 °C gentle, dry on a hanger, iron while slightly damp.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keten: 30–40 °C hassas, askıda kurut, hafif nemliyken ütüle."
          }
        }
      }
    },
    "Elastane blends: no tumble dryer; heat ruins the stretch.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elastanlı kumaşlar: kurutma makinesine atma; ısı esnekliği bozar."
          }
        }
      }
    },
    "Wash dark and bright colours apart the first few times, and check the care label.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koyu ve canlı renkleri ilk birkaç yıkamada ayrı yıka, bakım etiketine mutlaka bak."
          }
        }
      }
    },
    "Scan my skin tone": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cilt tonumu tara"
          }
        }
      }
    },
    "Scan my skin tone again": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cilt tonumu yeniden tara"
          }
        }
      }
    },
    "The front camera reads your skin's depth and undertone in a few seconds, in daylight. Or choose them below.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ön kamera gün ışığında birkaç saniyede cildinin tonunu ve alt tonunu okur. Ya da aşağıdan seç."
          }
        }
      }
    },
    "Which style do you like?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi tarzı seviyorsun?"
          }
        }
      }
    },
    "What do you dress for most?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En çok ne için giyiniyorsun?"
          }
        }
      }
    },
    "How do you like clothes to sit?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kıyafetlerin nasıl oturmasını seversin?"
          }
        }
      }
    },
    "Everyday": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük"
          }
        }
      }
    },
    "Evenings": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akşam"
          }
        }
      }
    },
    "Active": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor"
          }
        }
      }
    },
    "V-necks and open collars lengthen the upper body.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V yaka ve açık yakalar üst gövdeyi uzun gösterir."
          }
        }
      }
    },
    "Tops that skim and fall past the waist; no tight waistbands or boxy cropped cuts.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücuda yapışmadan dökülen, beli geçen üstler; dar bel bantları ve kutu kesim kısa üstler yok."
          }
        }
      }
    },
    "Detail, colour and structure on top: boat necks, a structured jacket.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Detay, renk ve duruş üstte olsun: kayık yaka, duruşlu bir ceket."
          }
        }
      }
    },
    "Straight, A-line or wide legs below, in darker colours.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altta düz, A kesim ya da geniş paça, koyu renklerde."
          }
        }
      }
    },
    "V-necks and soft shoulders on top; no shoulder pads or wide stripes across the chest.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üstte V yaka ve yumuşak omuzlar; vatka ve göğüste enine geniş çizgi yok."
          }
        }
      }
    },
    "Some volume or a lighter colour below: straight or relaxed trousers, A-line skirts.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altta biraz hacim ya da açık renk: düz ya da rahat pantolon, A kesim etek."
          }
        }
      }
    },
    "Show the waist: wrap and belted pieces, high waists, fitted rather than boxy.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beli göster: kruvaze ve kemerli parçalar, yüksek bel; kutu değil vücuda oturan."
          }
        }
      }
    },
    "Create shape: layers, a belt or a defined waist, structured shoulders.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Form kat: katmanlar, kemer ya da belirgin bel, duruşlu omuzlar."
          }
        }
      }
    },
    "Relaxed doesn't mean big: pair one roomy piece with one fitted one.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahat, büyük demek değil: bir bol parçayı bir oturan parçayla eşleştir."
          }
        }
      }
    },
    "Fitted means following the body, not pulling: no creases across buttons or seams.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturan, vücudu takip eder ama çekmez: düğme ya da dikiş boyunca kırışık olmamalı."
          }
        }
      }
    },
    "Fluid fabrics that drape: viscose, modal, soft cotton jersey, light wool.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dökümlü akışkan kumaşlar: viskon, modal, yumuşak pamuklu süprem, ince yün."
          }
        }
      }
    },
    "Structured fabrics on top (cotton twill, poplin, denim), soft drape below.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üstte duruşlu kumaşlar (pamuk dimi, poplin, denim), altta yumuşak dökümlü."
          }
        }
      }
    },
    "Soft, unstructured tops (jersey, merino), heavier fabrics below.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üstte yumuşak, duruşsuz kumaşlar (süprem, merino), altta daha ağır kumaşlar."
          }
        }
      }
    },
    "Fabrics with some stretch and drape that follow the shape: jersey, crepe, stretch cotton.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hattı takip eden, biraz esnek ve dökümlü kumaşlar: süprem, krep, esnek pamuk."
          }
        }
      }
    },
    "Fabrics with body that hold a shape: cotton twill, denim, wool, structured knits.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Formunu koruyan gövdeli kumaşlar: pamuk dimi, denim, yün, duruşlu triko."
          }
        }
      }
    },
    "For work: wool and wool blends, cotton poplin, crepe; they keep their shape all day.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş için: yün ve yün karışımları, pamuk poplin, krep; gün boyu formunu korur."
          }
        }
      }
    },
    "Every day: cotton, denim and merino; easy to wash and breathable.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük: pamuk, denim ve merino; kolay yıkanır, nefes alır."
          }
        }
      }
    },
    "Evenings: one piece with sheen (satin, silk, velvet), the rest matt.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akşam: tek bir parlak parça (saten, ipek, kadife), gerisi mat."
          }
        }
      }
    },
    "Active: technical knits with elastane and quick-drying cotton blends.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor: elastanlı teknik örgüler ve çabuk kuruyan pamuk karışımları."
          }
        }
      }
    },
    "Stiff or shiny fabrics (satin, taffeta) and thin clingy knits over the middle.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gövde ortasında sert ya da parlak kumaşlar (saten, tafta) ve ince yapışan örgüler."
          }
        }
      }
    },
    "Thin clingy fabrics over the hips and thighs.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalça ve basende ince, yapışan kumaşlar."
          }
        }
      }
    },
    "Stiff, bulky fabrics across the shoulders.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omuzlarda sert, hacimli kumaşlar."
          }
        }
      }
    },
    "Stiff boxy fabrics that hide the waist.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beli saklayan sert, kutu kumaşlar."
          }
        }
      }
    },
    "Very limp fabrics that hang straight down.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dümdüz aşağı sarkan çok yumuşak kumaşlar."
          }
        }
      }
    },
    "Use this": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu kullan"
          }
        }
      }
    },
    "Fit your face in the oval": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzünü ovalin içine yerleştir"
          }
        }
      }
    },
    "Daylight or a bright room, no filter or heavy make-up. Nothing is saved or sent.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün ışığı ya da aydınlık oda; filtre ve yoğun makyaj olmasın. Hiçbir şey kaydedilmez ya da gönderilmez."
          }
        }
      }
    },
    "60-30-10: about 60%% of an outfit in %@, 30%% in %@ and a 10%% accent of %@. Keep your best colours near your face.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "60-30-10: kombinin yaklaşık %%60'ı %1$@, %%30'u %2$@, %%10 vurgu olarak %3$@. En iyi renklerini yüzüne yakın kullan."
          }
        }
      }
    },
    "Step back about three steps": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç adım kadar geri çekil"
          }
        }
      }
    },
    "Arms slightly out: the front photo": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kollar hafif açık: önden fotoğraf"
          }
        }
      }
    },
    "Done: your measurements are ready": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti: ölçülerin hazır"
          }
        }
      }
    },
    "Great. Now, counting slowly to ten in your head, turn once all the way round in place, with your arms straight out to the sides.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harika. Şimdi içinden yavaşça ona kadar sayarak, kolların iki yana tam açık, kendi etrafında bir tam tur dön."
          }
        }
      }
    },
    "After 3, 2, 1: arms straight out to the sides, turn once round slowly while counting to ten.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3, 2, 1'den sonra: kollar iki yana tam açık, ona kadar sayarak yavaşça bir tur dön."
          }
        }
      }
    },
    "Listen: 3, 2, 1, then arms straight out": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinle: 3, 2, 1, sonra kollar iki yana"
          }
        }
      }
    },
    "Turn once round slowly, counting to ten": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ona kadar sayarak yavaşça bir tur dön"
          }
        }
      }
    },
    "Leg cut": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paça kesimi"
          }
        }
      }
    },
    "Skinny": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skinny (dar)"
          }
        }
      }
    },
    "Straight leg": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boru paça"
          }
        }
      }
    },
    "Wide leg": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geniş paça"
          }
        }
      }
    },
    "Flare / bootcut": {
      "localizations": {
        "tr": {
          "stringUnit": {
