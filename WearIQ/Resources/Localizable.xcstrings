      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyun"
          }
        }
      }
    },
    "Your height is the ruler for every other measurement, so please enter it accurately.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyun diğer tüm ölçüler için cetvel görevi görür, lütfen doğru gir."
          }
        }
      }
    },
    "How do you like clothes to fit?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kıyafetlerin nasıl oturmasını seversin?"
