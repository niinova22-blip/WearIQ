      }
    },
    "Tape (cm) · A · B": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezura (cm) · A · B"
          }
        }
      }
    },
    "A: current engine. B: silhouette fit. ◆ seen by the camera, ◇ from the body model, ○ from height and weight. The error is against your tape value.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "A: mevcut motor. B: siluet oturtma. ◆ kameranın gördüğü, ◇ vücut modelinden, ○ boy ve kilodan. Hata, girdiğin mezura değerine göre."
          }
        }
      }
    },
