    "Didn't buy it after all": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonunda almadım"
          }
        }
      }
    },
    "How did it fit?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasıl oldu?"
