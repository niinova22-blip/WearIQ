          }
        }
      }
    },
    "Bra size, e.g. 75B or 34C": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sütyen bedeni, ör. 75B ya da 34C"
          }
        }
      }
    },
    "Couldn't read that size; write the band and the cup, like 75B.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu beden okunamadı; bant ve kupayı 75B gibi yaz."
          }
        }
      }
    },
    "Bra size (optional)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sütyen bedeni (isteğe bağlı)"
          }
        }
      }
    },
    "Shapes the bust on your avatar. Size advice still uses your chest measurement.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avatarındaki göğüs şeklini belirler. Beden önerisi yine göğüs ölçünü kullanır."
          }
        }
      }
    },
    "Your way of wearing clothes": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giyinme tarzın"
          }
        }
      }
    },
    "Every check now also says which size suits your style.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık her kontrol, tarzına hangi bedenin uyduğunu da söylüyor."
          }
        }
      }
    },
    "Learn it again": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden öğren"
          }
        }
      }
    },
    "Wear the clothes you love most and stand in front of the phone. WearIQ sees how you like them to sit (close, regular or roomy) and your colours, and then tells you which size suits your style, not just your body.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En sevdiğin kıyafetleri giy ve telefonun karşısına geç. WearIQ kıyafetlerin üzerinde nasıl durmasını sevdiğini (dar, normal ya da bol) ve renklerini görür; sonra sadece vücuduna değil tarzına da hangi bedenin uyduğunu söyler."
          }
        }
      }
    },
    "Learn my style": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilimi öğren"
          }
        }
      }
    },
    "Tops: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üstler: %@"
          }
        }
      }
    },
