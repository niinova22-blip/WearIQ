    "Size %@ fits": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ beden oturuyor"
          }
        }
      }
    },
    "Size %@: close, a little off in places": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ beden: yakın, yer yer biraz farklı"
          }
        }
      }
    },
    "We'll ask in a few days how %@ fits.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç gün sonra %@ bedenin nasıl olduğunu soracağız."
          }
        }
      }
    },
    "Ordered it: remind me to say how it fits": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sipariş verdim: nasıl olduğunu söylemem için hatırlat"
