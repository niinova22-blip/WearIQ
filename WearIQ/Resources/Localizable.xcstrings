          }
        }
      }
    },
    "On: sizes are suggested for skirts and dresses, by their length. Off: for trousers, by how they sit and their leg cut.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıksa beden önerileri etek ve elbiseler için boylarına göre yapılır. Kapalıysa pantolonlar için, nasıl durduklarına ve paça kesimine göre."
