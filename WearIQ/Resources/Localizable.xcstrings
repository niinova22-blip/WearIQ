    "Privacy policy": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik politikası"
          }
        }
      }
    },
    "A is the app's scan, with engine C's correction for the camera's perspective; C alone is shown beside it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "A, uygulamanın taramasıdır ve kameranın perspektifi için motor C düzeltmesini içerir; C tek başına yanında gösterilir."
