      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En sevdiğin kıyafetleri giy: kendini en iyi hissettiğin kombini."
          }
        }
      }
    },
    "Lean the phone upright at about waist height, front camera towards you.": {
      "localizations": {
