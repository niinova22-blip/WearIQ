      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanım amacı"
          }
        }
      }
    },
    "Colour preferences": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renk tercihleri"
          }
        }
      }
    },
    "Colours I like": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevdiğim renkler"
          }
        }
      }
    },
    "Colours I avoid": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaçındığım renkler"
          }
        }
      }
    },
    "No outfit fits this occasion and season yet. Add at least one top and one bottom (or a dress) tagged with a matching style and season.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kullanım amacı ve mevsim için henüz kombin yok. Uygun stil ve mevsimle işaretlenmiş en az bir üst ve bir alt (ya da bir elbise) ekle."
          }
        }
      }
    },
    "Outfit %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombin %lld"
          }
        }
      }
    },
    "Match %lld percent": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzde %lld uyum"
          }
        }
      }
    },
    "%lld%%": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%%%lld"
          }
        }
      }
    },
    "Suits the occasion": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanım amacına uygun"
          }
        }
      }
    },
    "Balanced colours": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengeli renkler"
          }
        }
      }
    },
    "%@ and %@ go well together": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ve %2$@ birbirine yakışıyor"
          }
        }
      }
    },
    "Includes %@, a colour you like": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sevdiğin renk olan %@ içeriyor"
          }
        }
      }
    },
    "Pieces that fit you well": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzerine iyi oturan parçalar"
          }
        }
      }
    },
    "Layered for the weather": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava için katmanlı"
          }
        }
      }
    },
    "Measurement tracking": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçü takibi"
          }
        }
      }
    },
    "Compare your scans over time and see which clothes may now fit differently.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taramalarını zaman içinde karşılaştır ve hangi kıyafetlerin artık farklı oturabileceğini gör."
          }
        }
      }
    },
    "Only one measurement so far": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdilik tek bir ölçüm var"
          }
        }
      }
    },
    "Scan again or update your measurements later to compare.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşılaştırmak için daha sonra yeniden tara veya ölçülerini güncelle."
          }
        }
      }
    },
    "Measurement changes": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçü değişimleri"
          }
        }
      }
    },
    "%@ → %@ cm": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@ cm"
          }
        }
      }
    },
    "%@ → %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@"
          }
        }
      }
    },
    "Differences smaller than the measurement uncertainty are shown as \"within measurement error\" and are not treated as real change.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçüm belirsizliğinden küçük farklar \"ölçüm hatası sınırında\" olarak gösterilir ve gerçek değişim sayılmaz."
          }
        }
      }
    },
    "Clothes that may fit differently": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı oturabilecek kıyafetler"
          }
        }
      }
    },
    "None of your saved garments are affected.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı kıyafetlerinin hiçbiri etkilenmiyor."
          }
        }
      }
    },
    "%@: %@ → %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@ → %3$@"
          }
        }
      }
    },
    "Increased": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arttı"
          }
        }
      }
    },
    "Decreased": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Azaldı"
          }
        }
      }
    },
    "Within measurement error": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçüm hatası sınırında"
          }
        }
      }
    },
    "Virtual try-on is in development. It will only ever process your photo with your explicit permission.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanal deneme geliştirme aşamasında. Fotoğrafın yalnızca açık iznin olursa işlenecek."
          }
        }
      }
    },
    "Weight": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo"
          }
        }
      }
    },
    "Body type": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut tipi"
          }
        }
      }
    },
