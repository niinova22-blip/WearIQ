    "About you": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakkında"
          }
        }
      }
    },
    "Prop the phone upright at waist height, about 2–3 m away.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu bel hizasında dik olarak, yaklaşık 2–3 m uzağa yerleştir."
          }
        }
      }
    },
    "Wear fitted clothes (e.g. sportswear) so your outline is visible.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut hatların görünsün diye dar kıyafet (ör. spor kıyafeti) giy."
          }
        }
      }
    },
    "Use a bright room with a plain background.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aydınlık ve sade arka planlı bir ortam seç."
          }
        }
      }
    },
    "Front photo: face the phone, arms slightly away from your body. Side photo: turn 90°.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ön fotoğraf: telefona dön, kolların vücudundan biraz uzakta. Yan fotoğraf: 90° dön."
          }
        }
      }
    },
    "Voice cues guide you; the photo is taken automatically.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli komutlar sana rehberlik eder, fotoğraf otomatik çekilir."
          }
        }
      }
    },
    "Photos are analysed on this device and deleted right after measuring.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar bu cihazda analiz edilir ve ölçümden hemen sonra silinir."
          }
        }
      }
    },
