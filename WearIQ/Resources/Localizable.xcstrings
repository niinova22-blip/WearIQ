    "Point the camera at the floor and move it slowly until the floor is found.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayı yere çevir ve zemin bulunana kadar yavaşça gezdir."
