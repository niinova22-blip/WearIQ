          }
        }
      }
    },
    "Waist loose, needs a belt": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bel bol, kemer ister"
          }
        }
      }
    },
    "Waist roomy": {
      "localizations": {
        "tr": {
