      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonra"
          }
        }
      }
    },
    "Size %@ is the closest to your favourite %@.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ beden, favorin olan %2$@ ürününe en yakın beden."
