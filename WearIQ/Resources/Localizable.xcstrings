          "stringUnit": {
            "state": "translated",
            "value": "Günün kombini Stil sekmesinde hazır."
          }
        }
      }
    },
    "%@ elastane: gives a little as you move and keeps its shape.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ elastan: hareket ettikçe biraz esner ve şeklini korur."
